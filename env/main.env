# Stage "main" (branch main). No secret values here: stage-db.ps1 generates them
# under DLC_RUNTIME_DIR, which is ignored by Git. Liquibase context: prod.
COMPOSE_PROJECT_NAME=dlc-main
DLC_ENVIRONMENT=prod
DLC_RUNTIME_DIR=./.local/stages/main
DLC_EDGE_SUBNET=172.33.0.0/24
DLC_FRONT_IP=172.33.0.240
DLC_GATEWAY_IP=172.33.0.241
DLC_FRONT_PORT=8083
DLC_PUBLIC_ORIGIN=http://localhost:8083
DLC_MAIL_PORT=18027
DLC_DB_VIEWER_PORT=18093
DLC_PATIENT_PORTAL_CONTEXT=../../patients/dlc-patient-portal
DLC_IMAGE_TAG=main
