DLC_ENVIRONMENT=qa
DLC_RUNTIME_DIR=./.local/stages/qa
DLC_EDGE_SUBNET=172.32.0.0/24
DLC_FRONT_IP=172.32.0.240
DLC_GATEWAY_IP=172.32.0.241
DLC_FRONT_PORT=8082
DLC_PUBLIC_ORIGIN=http://localhost:8082
DLC_MAIL_PORT=18026
DLC_DB_VIEWER_PORT=18092
DLC_PATIENT_PORTAL_CONTEXT=../../patients/dlc-patient-portal
DLC_IMAGE_TAG=qa
