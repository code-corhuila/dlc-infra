# Stage "develop" (branch develop). No secret values here: stage-db.ps1 generates them
# under DLC_RUNTIME_DIR, which is ignored by Git. Liquibase context: dev.
COMPOSE_PROJECT_NAME=dlc-develop
DLC_ENVIRONMENT=dev
DLC_RUNTIME_DIR=./.local/stages/develop
DLC_EDGE_SUBNET=172.31.0.0/24
DLC_FRONT_IP=172.31.0.240
DLC_GATEWAY_IP=172.31.0.241
DLC_FRONT_PORT=8081
DLC_PUBLIC_ORIGIN=http://localhost:8081
DLC_MAIL_PORT=18025
DLC_DB_VIEWER_PORT=18091
DLC_PATIENT_PORTAL_CONTEXT=../../patients/dlc-patient-portal
DLC_IMAGE_TAG=develop
